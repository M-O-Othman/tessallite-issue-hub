# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql+psycopg://issue_hub:secret_password@localhost:5432/issue_hub

# Operational Environment: 'development' or 'production'
ISSUE_HUB_ENV=development

# Authentication Tokens and Secrets
ISSUE_HUB_API_TOKEN=api_bearer_token_123
ISSUE_HUB_SESSION_SECRET=super_secret_session_key_9999

# Web Admin Portal Authentication
ISSUE_HUB_WEB_USERNAME=admin
ISSUE_HUB_WEB_PASSWORD_HASH=$2b$12$NI1nVKBiPNUw2ld6d8mQFutz5GXVgtmh6C.OwUm9fbG..qCXhyrka

# Default Issue Metadata Context
ISSUE_HUB_DEFAULT_PROJECT=tessallite
ISSUE_HUB_DEFAULT_REPOSITORY=tessallite-workspace
ISSUE_HUB_DEFAULT_BRANCH=main

# Feature Flags
ISSUE_HUB_IMPORT_ENABLED=true
